# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# ---------------------------------------------------------------------------

# REQUIRED. API key for the model endpoint.
# NVIDIA NIM (free tier): https://build.nvidia.com
NVIDIA_NIM_API_KEY=nvapi-REPLACE_WITH_YOUR_KEY

# OPTIONAL. Any OpenAI-compatible chat-completions base URL.
# NVIDIA NIM:   https://integrate.api.nvidia.com/v1
# Local Ollama: http://127.0.0.1:11434/v1
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# OPTIONAL. Model id sent to the endpoint.
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# ---------------------------------------------------------------------------
# Storage (all optional — defaults shown)
# ---------------------------------------------------------------------------

# SQLite database file. Migrations run automatically on start.
# DATABASE_PATH=data/studyforge.db

# Where uploaded originals are stored so page previews can be rendered.
# Never served as static files.
# UPLOADS_DIR=data/files

# Maximum upload size in megabytes (default 25).
# MAX_UPLOAD_MB=25